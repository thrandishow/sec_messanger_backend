{
  "name": "shifr-svyaz-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
