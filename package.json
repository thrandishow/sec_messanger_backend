{
  "name": "shifr-svyaz-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "cargo build --locked --manifest-path api/Cargo.toml && cargo build --locked --manifest-path broker/Cargo.toml",
    "test": "node scripts/test-postgres.mjs test/*.test.ts",
    "test:integration": "node scripts/test-postgres.mjs test/integration/*.test.ts",
    "test:stack": "SHIFR_TEST_PROXY=1 node scripts/test-postgres.mjs test/integration/*.test.ts",
    "check": "npm run build && npm test && npm run test:integration",
    "dev": "set -a; . ./.env && exec cargo run --locked --manifest-path api/Cargo.toml",
    "start": "set -a; . ./.env && exec ./api/target/debug/shifr-api"
  },
  "devDependencies": {
    "ws": "8.22.2"
  }
}
