# Docker-only first start: ./start.sh 192.168.1.10
HOST=0.0.0.0
PORT=8443
LAN_IP=192.168.1.10
ALLOWED_ORIGINS=https://192.168.1.10:8443,https://192.168.1.10:3000
DATABASE_PATH=./data/shifr.sqlite
TLS_CERT_PATH=./runtime/tls/server.crt
TLS_KEY_PATH=./runtime/tls/server.key
IRC_HOST=127.0.0.1
IRC_PORT=6667
IRC_PASSWORD=
REGISTRATION_TOKEN=
SESSION_TTL_SECONDS=86400
# Only Compose overrides this to 1 behind the private Nginx proxy.
TRUST_PROXY=0
